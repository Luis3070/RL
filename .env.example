# Copy this file to `.env` and adjust the paths for your machine.
# `.env` is gitignored; never commit it.
#
# Only simple KEY=VALUE lines are supported (optional `export `, optional
# quotes, trailing ` # comment`). No variable expansion and no commands: the
# file is read by both a Python loader and a shell loader, and only the two
# keys below are used.
#
# Both variables are OPTIONAL. When unset, defaults are derived:
#   RL_REPO_DIR       -> the repository root (resolved from the script location)
#   SABANAHERONS_DIR  -> the sibling directory ../SabanaHerons2026

# Absolute path of this RL repository.
RL_REPO_DIR=/path/to/RL

# Absolute path of the C++ B-Human fork (SabanaHerons2026).
SABANAHERONS_DIR=/path/to/SabanaHerons2026
